# Copy to .env for local use. On Vercel, add these in Project Settings > Environment Variables.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Who may convert PDFs. Use ACCESS_CODES (one personal code per teacher), ACCESS_CODE (one shared code), or both.
# Without any code, anyone with the URL can spend your AI credit, so production refuses to convert until one is set.
#
# ACCESS_CODES: name:code pairs separated by commas. Names use a-z, 0-9, "-" and "_" (up to 32 characters).
# To revoke one teacher, delete their pair and redeploy. Codes that still say CHANGE-ME are refused.
ACCESS_CODES=anna:CHANGE-ME-long-code,ben:CHANGE-ME-another-long-code
# ACCESS_CODE: a single code for the whole school. Simpler, but it cannot be revoked for one person.
# ACCESS_CODE=CHANGE-ME-long-shared-password

# ---------------------------------------------------------------------------
# Spending limits (optional)
# ---------------------------------------------------------------------------
# Conversions one teacher may start per day (UTC), and for the whole school. 0 means no limit.
# DAILY_LIMIT_PER_TEACHER=30
# DAILY_LIMIT_TOTAL=150
# Days to keep a finished conversion, so converting the same PDF again costs nothing. 0 switches the cache off.
# CACHE_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Shared storage (optional)
# ---------------------------------------------------------------------------
# Upstash Redis over HTTPS. Without it everything still works, but limits only last as long as a server instance,
# and short links and QR codes are switched off. On Vercel, adding Upstash from the Marketplace fills these in
# (the names KV_REST_API_URL and KV_REST_API_TOKEN are accepted too).
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
# Days a short link keeps working.
# SHARE_TTL_DAYS=90
# Secret used to scramble visitors' IP addresses before they are counted, so raw addresses are never stored.
# If you leave it out, a value derived from the API key is used.
# RATE_LIMIT_SECRET=a-long-random-string

# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------
# CLAUDE_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_URL changes the AI endpoint (default https://api.anthropic.com/v1/messages). Only for testing against a fake server.
# MOCK=1 returns a demo worksheet without calling the AI (local testing only).
# VERCEL_ENV is set by Vercel ("production" on the live site). PORT is read by the local server.
